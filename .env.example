# Copy to .env and fill in real values. Never commit .env itself.

# Google AI Studio key (https://aistudio.google.com) — free tier, no credit card.
GEMINI_API_KEY=your_key_here

# HTTP port for the Express server.
PORT=3000

# Postgres via docker compose (service "db"; host port 5433 - a native
# Postgres may already own 5432 on some machines).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/flyrank_image_relevance

# Bearer token guarding /admin/* routes. Empty = open in development.
ADMIN_TOKEN=
